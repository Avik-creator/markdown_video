NEXT_PUBLIC_SITE_URL=https://your-production-site.com

# Required for project sharing, distributed rate limiting, and rendered-video
# object storage.
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# Required for the render_preview and render_video MCP tools. The secret must
# be identical on the web app and worker and should be at least 32 random chars.
# Generate one with: openssl rand -hex 32
RENDER_WORKER_URL="https://your-render-worker.example.com"
RENDER_WORKER_SHARED_SECRET="replace-with-a-64-character-random-hex-secret"
